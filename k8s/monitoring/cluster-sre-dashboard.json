{
  "panels": [
    {
      "fieldConfig": {
        "defaults": {
          "max": 50,
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(kube_pod_info)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "Pods",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(up{job=\"kubernetes-nodes\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "Nodes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total[2m]))/sum(machine_cpu_cores)*100",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "CPU %",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "fieldConfig": {
        "defaults": {
          "max": 8,
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          },
          "unit": "gb"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes)/1024/1024/1024",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "Mem GB",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(up{job=\"kubernetes-service-endpoints\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "Svcs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total[2m]))by(namespace)",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "CPU by NS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes)by(namespace)/1024/1024",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "Mem by NS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "count(kube_pod_info)by(namespace)",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "Pods per NS",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ],
  "title": "Cluster SRE",
  "uid": "cluster-sre",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  }
}